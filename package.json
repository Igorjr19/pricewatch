{
  "name": "pricewatch",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pricewatch": "dist/main.js"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js serve",
    "check": "tsc --noEmit && biome check --diagnostic-level=error . && vitest run --reporter=dot",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "req": "node scripts/req.mjs",
    "req:check": "node scripts/req-check.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "nest-commander": "^3.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/node": "^24.0.0",
    "lefthook": "^1.10.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
