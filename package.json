{
  "name": "pricewatch",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pricewatch": "dist/main.js"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js serve",
    "check": "tsc --noEmit && biome check --diagnostic-level=error . && vitest run --reporter=dot",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=dot",
    "db:generate": "drizzle-kit generate",
    "req": "node scripts/req.mjs",
    "req:check": "node scripts/req-check.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "nest-commander": "^3.21.0",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^1.10.0",
    "supertest": "^7.3.1",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
