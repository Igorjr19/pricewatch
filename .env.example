# pricewatch configuration (spec §6.1). Values shown are the defaults.
# Required for `serve`: PW_API_TOKEN (set a long random value).

PW_PORT=8080
PW_API_TOKEN=change-me
# Token accepted on POST /api/v1/run (defaults to PW_API_TOKEN)
# PW_RUN_TOKEN=
PW_TZ=America/Sao_Paulo
# debug | info | warn | error
PW_LOG_LEVEL=info

PW_DATABASE_URL=file:/data/pricewatch.db
# Required when PW_DATABASE_URL is libsql://
# PW_DATABASE_TOKEN=
PW_AUTO_MIGRATE=true

# Scheduling and cycle limits
PW_TICK=5m
PW_SCRAPE_INTERVAL=3h
PW_SCRAPE_JITTER=20m
PW_CONCURRENCY=2
PW_DOMAIN_DELAY=8s
PW_RUN_MAX_LISTINGS=50
PW_RUN_TIMEOUT=10m
PW_MAX_BACKOFF=24h
PW_RETENTION_DAYS=90
PW_FAILING_THRESHOLD=5

# Fetching
PW_HTTP_TIMEOUT=20s
# PW_USER_AGENT=
# off | local | ws://host:port (M1 accepts only off)
PW_BROWSER=off
# PW_BROWSER_TIMEOUT=45s
# Development only: answer from fixtures' manifest.json files, no network
# PW_FETCH_FIXTURES_DIR=test/fixtures

# Alerts and notifications
PW_ALERT_COOLDOWN=12h
# Comma-separated channel names (default: all configured)
# PW_DEFAULT_CHANNELS=
# PW_SYSTEM_CHANNELS=
# Channels: telegram://… | smtp(s)://… | webhook+https://…
# PW_CHANNEL_PHONE=telegram://123:ABC@-1001234
# PW_CHANNEL_MAIL=smtps://me:secret@smtp.gmail.com:465?from=me@gmail.com&to=me@gmail.com
# PW_CHANNEL_N8N=webhook+https://n8n.local/webhook/pw?secret=abc

# Optional: enables the Mercado Livre `api` strategy
# PW_MELI_CLIENT_ID=
# PW_MELI_CLIENT_SECRET=
