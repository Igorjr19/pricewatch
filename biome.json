{
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.claude",
      "!.mcp.json",
      "!test/fixtures",
      "!drizzle"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "useImportType": "off" },
      "nursery": { "noFloatingPromises": "error" }
    }
  }
}
